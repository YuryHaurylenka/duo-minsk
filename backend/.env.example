APP_NAME=DUO API
ENVIRONMENT=development
# Runtime connection: copy the Transaction Pooler URI from Supabase Dashboard > Connect.
# For a dedicated login, use username duo_api.PROJECT_REF; never use a service-role API key here.
DATABASE_URL=postgresql+psycopg://duo_api.crlbtvktwyijkbiiglpk:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require
# Admin connection used only for Alembic migrations from a trusted local machine.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.crlbtvktwyijkbiiglpk.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://crlbtvktwyijkbiiglpk.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Set only if the project still signs JWTs with HS256.
SUPABASE_JWT_SECRET=
CORS_ORIGINS=https://minsk-date-ideas.vercel.app,http://localhost:3000,http://localhost:5173
